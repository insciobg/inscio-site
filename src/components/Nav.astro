---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/industries', label: 'Industries' },
  { href: '/dealercloud', label: 'DealerCloud' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'Company' },
];
const currentPath = Astro.url.pathname;
---

<nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0">
        <img
          src="https://cdn.prod.website-files.com/685efaa4c673486389582cef/6866e4ea24473711f3502fe5_InscioLogo%20with%20stripes.png"
          alt="Inscio — NetSuite consulting"
          class="h-14 w-auto"
        />
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors ${
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-blue-600'
                : 'text-gray-700 hover:text-gray-900'
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="hidden md:block">
        <a
          href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-[#0D1235] text-white text-sm font-semibold px-6 py-3 rounded hover:bg-[#1a2050] transition-colors"
        >
          Schedule a Strategy Call
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button id="menu-toggle" class="md:hidden p-2 rounded text-gray-600 hover:text-gray-900" aria-label="Toggle menu">
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <div class="px-4 py-4 flex flex-col gap-4">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`text-sm font-medium ${
            currentPath === link.href ? 'text-blue-600' : 'text-gray-700'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-[#0D1235] text-white text-sm font-semibold px-5 py-3 rounded text-center"
      >
        Schedule a Strategy Call
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
