---
const navLinks = [
  { label: 'Home', href: '/' },
  {
    label: 'Services',
    href: '/services',
    dropdown: [
      { label: 'All Services', href: '/services' },
      { label: 'Evaluation & Licensing', href: '/services#evaluation' },
      { label: 'Implementation', href: '/services#implementation' },
      { label: 'Optimization', href: '/services#optimization' },
      { label: 'Support & Training', href: '/services#support' },
    ],
  },
  {
    label: 'Resources',
    href: '/resources',
    dropdown: [
      { label: 'All Resources', href: '/resources' },
      { label: 'NetSuite Project Estimator', href: '/estimator' },
      { label: 'Video Library', href: '/videos' },
      { label: 'Resource Library', href: '/library' },
      { label: 'Blog', href: '/blog' },
    ],
  },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center flex-shrink-0">
        <img
          src="https://cdn.prod.website-files.com/670669af02de9c68ed0ce9aa/6706a1ab7db7ccba08a1eb0b_Inscio%20Logo%20Light%20Background.svg"
          alt="Inscio"
          class="h-8 w-auto"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <div class="relative group">
            <a
              href={link.href}
              class={`flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-lg transition-colors duration-150
                ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-blue-600 bg-blue-50'
                  : 'text-gray-700 hover:text-blue-600 hover:bg-gray-50'}`}
            >
              {link.label}
              {link.dropdown && (
                <svg class="w-4 h-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {link.dropdown && (
              <div class="absolute top-full left-0 mt-1 w-56 bg-white rounded-xl shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="py-2">
                  {link.dropdown.map((item) => (
                    <a
                      href={item.href}
                      class="block px-4 py-2.5 text-sm text-gray-700 hover:text-blue-600 hover:bg-blue-50 transition-colors duration-150"
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- CTA -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
          target="_blank"
          rel="noopener"
          class="btn-primary text-sm"
        >
          Book a Strategy Call
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100"
        aria-label="Open menu"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
    <div class="px-4 py-3 space-y-1">
      {navLinks.map((link) => (
        <div>
          <a
            href={link.href}
            class={`block px-3 py-2 text-sm font-medium rounded-lg
              ${currentPath === link.href ? 'text-blue-600 bg-blue-50' : 'text-gray-700 hover:bg-gray-50'}`}
          >
            {link.label}
          </a>
          {link.dropdown && (
            <div class="ml-4 mt-1 space-y-1">
              {link.dropdown.slice(1).map((item) => (
                <a
                  href={item.href}
                  class="block px-3 py-2 text-sm text-gray-500 hover:text-blue-600 rounded-lg hover:bg-gray-50"
                >
                  {item.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-3 border-t border-gray-100">
        <a
          href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
          target="_blank"
          rel="noopener"
          class="btn-primary block text-center text-sm"
        >
          Book a Strategy Call
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
