</Layout>

<script>
  const tabs = document.querySelectorAll('.culture-tab');
  const panels = document.querySelectorAll('.culture-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.panel;

      tabs.forEach(t => {
        t.classList.remove('active-tab', 'bg-white', 'text-gray-900', 'border-gray-300', 'shadow-sm');
        t.classList.add('text-gray-500', 'border-gray-200', 'hover:border-gray-300', 'hover:text-gray-700');
      });
      tab.classList.add('active-tab', 'bg-white', 'text-gray-900', 'border-gray-300', 'shadow-sm');
      tab.classList.remove('text-gray-500', 'border-gray-200');

      panels.forEach(p => p.classList.add('hidden'));
      document.getElementById('panel-' + target)?.classList.remove('hidden');
      const gbs = document.getElementById('giveback-stats');
      if (gbs) { if (target === 'giveback') { gbs.classList.remove('hidden'); } else { gbs.classList.add('hidden'); } }
    });
  });

  // Set initial tab styles
  tabs.forEach((tab, i) => {
    if (i === 0) {
      tab.classList.add('bg-white', 'text-gray-900', 'border-gray-300', 'shadow-sm');
    } else {
      tab.classList.add('text-gray-500', 'border-gray-200', 'hover:border-gray-300', 'hover:text-gray-700');
    }
  });
</script>
