---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="DealerCloud for NetSuite | Equipment Dealer Management System | Inscio"
  description="The All-In-One DMS Built for Equipment Dealers. Purpose-built on NetSuite. 300% ROI, $500K average annual benefit, 16-month payback."
>

  <!-- Hero -->
  <section class="bg-[#0D1235] text-white py-28 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">DEALER MANAGEMENT SYSTEM</p>
      <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">
        The All-In-One DMS Built for Equipment Dealers
      </h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed mb-10">
        Purpose-built on NetSuite. 300% ROI, $500K average annual benefit, 16-month payback — for dealers who want one system that actually runs the business.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session" target="_blank" rel="noopener noreferrer"
          class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded transition-colors">
          Request a Demo
        </a>
        <a href="#capabilities"
          class="border border-white text-white hover:bg-white hover:text-[#0D1235] font-semibold px-8 py-4 rounded transition-colors">
          See Capabilities
        </a>
      </div>
    </div>
  </section>

  <!-- One Platform -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mb-12">
        <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">PURPOSE-BUILT FOR EQUIPMENT DEALERS</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">One Platform. Every Dealership Function.</h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-4">
          DealerCloud consolidates the fragmented tools dealerships rely on into a single, cloud-based system — giving your team real-time visibility across departments, reducing manual work, and enabling data-driven decisions from the shop floor to the back office.
        </p>
        <p class="text-gray-600 text-lg leading-relaxed">
          Built on Oracle NetSuite, it brings enterprise-grade reliability and scalability to equipment dealers of all sizes.
        </p>
      </div>

      <!-- Proven Results -->
      <div class="bg-[#0D1235] text-white rounded-2xl p-10 mb-16">
        <p class="text-blue-400 text-sm font-semibold uppercase tracking-wider mb-8 text-center">PROVEN RESULTS</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
          {[
            { stat: '300%', label: 'Average ROI for DealerCloud customers' },
            { stat: '$500K', label: 'Annual benefit realized per dealership' },
            { stat: '16 mo', label: 'Average payback period' },
          ].map(item => (
            <div>
              <div class="text-5xl font-extrabold text-white mb-3">{item.stat}</div>
              <div class="text-gray-400 text-sm">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="bg-gray-50 py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-14">
        <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">PLATFORM CAPABILITIES</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Everything Your Dealership Needs</h2>
        <p class="text-gray-600 text-lg">Eight integrated modules — each purpose-built for equipment dealers, all working together in one system.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Service -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">Service</h3>
          <p class="text-gray-600 text-sm leading-relaxed">End-to-end work order management, technician scheduling, warranty tracking, and service history — all in one place. Maximize shop throughput and reduce turnaround times.</p>
        </div>

        <!-- Tech Connect -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">Tech Connect</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Mobile-first tools for service technicians to access work orders, capture time, upload photos, and close jobs from anywhere — even offline.</p>
        </div>

        <!-- Parts -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">Parts</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Real-time parts inventory, automated reordering, bin management, and integration with major supplier catalogs to keep your parts counter running smoothly.</p>
        </div>

        <!-- Rental -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">Rental</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Complete rental fleet management with contract handling, utilization tracking, billing automation, and maintenance scheduling to maximize asset ROI.</p>
        </div>

        <!-- CRM -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">CRM</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Customer and prospect management built for dealerships — track interactions, manage opportunities, and stay on top of follow-ups across your entire sales team.</p>
        </div>

        <!-- Finance & Accounting -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">Finance &amp; Accounting</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Native NetSuite accounting with dealer-specific workflows — AP, AR, general ledger, and financial reporting tailored to equipment dealer operations.</p>
        </div>

        <!-- Time & Timeclock -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">Time &amp; Timeclock</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Accurate labor tracking for shop and field technicians, integrated directly with payroll and job costing to eliminate manual time entry and discrepancies.</p>
        </div>

        <!-- Platform & AI -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">Platform &amp; AI</h3>
          <p class="text-gray-600 text-sm leading-relaxed">The intelligence layer powering DealerCloud — with built-in AI tools, workflow automation, and real-time dashboards that surface insights across every department.</p>
        </div>

        <!-- eCommerce & BI -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="w-9 h-9 text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-3">eCommerce &amp; BI</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Sell parts and equipment online with an integrated eCommerce storefront, backed by business intelligence reporting to track performance across your entire operation.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0D1235] text-white py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-wider mb-4">READY TO SEE IT IN ACTION?</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-6">See DealerCloud in Action</h2>
      <p class="text-gray-300 text-lg mb-10">Learn how DealerCloud can unify your dealership operations and deliver measurable results from day one.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://dealercloud.io" target="_blank" rel="noopener noreferrer"
          class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded transition-colors">
          Visit DealerCloud
        </a>
        <a href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session" target="_blank" rel="noopener noreferrer"
          class="border border-white text-white hover:bg-white hover:text-[#0D1235] font-semibold px-8 py-4 rounded transition-colors">
          Request a Demo
        </a>
      </div>
    </div>
  </section>

</Layout>
