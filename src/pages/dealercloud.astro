---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="DealerCloud for NetSuite | Equipment Dealer Management System | Inscio"
  description="The All-In-One DMS Built for Equipment Dealers. Purpose-built on NetSuite. 300% ROI, $500K average annual benefit, 16-month payback."
>

  <!-- Hero -->
  <section class="bg-[#0D1235] text-white py-28 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">DEALER MANAGEMENT SYSTEM</p>
      <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">
        The All-In-One DMS Built for Equipment Dealers
      </h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed mb-10">
        Purpose-built on NetSuite. 300% ROI, $500K average annual benefit, 16-month payback — for dealers who want one system that actually runs the business.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session" target="_blank" rel="noopener noreferrer"
          class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded transition-colors">
          Request a Demo
        </a>
        <a href="#capabilities"
          class="border border-white text-white hover:bg-white hover:text-[#0D1235] font-semibold px-8 py-4 rounded transition-colors">
          See Capabilities
        </a>
      </div>
    </div>
  </section>

  <!-- One Platform -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mb-12">
        <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">PURPOSE-BUILT FOR EQUIPMENT DEALERS</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">One Platform. Every Dealership Function.</h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-4">
          DealerCloud consolidates the fragmented tools dealerships rely on into a single, cloud-based system — giving your team real-time visibility across departments, reducing manual work, and enabling data-driven decisions from the shop floor to the back office.
        </p>
        <p class="text-gray-600 text-lg leading-relaxed">
          Built on Oracle NetSuite, it brings enterprise-grade reliability and scalability to equipment dealers of all sizes.
        </p>
      </div>

      <!-- Proven Results -->
      <div class="bg-[#0D1235] text-white rounded-2xl p-10 mb-16">
        <p class="text-blue-400 text-sm font-semibold uppercase tracking-wider mb-8 text-center">PROVEN RESULTS</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
          {[
            { stat: '300%', label: 'Average ROI for DealerCloud customers' },
            { stat: '$500K', label: 'Annual benefit realized per dealership' },
            { stat: '16 mo', label: 'Average payback period' },
          ].map(item => (
            <div>
              <div class="text-5xl font-extrabold text-white mb-3">{item.stat}</div>
              <div class="text-gray-400 text-sm">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="bg-gray-50 py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-14">
        <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">PLATFORM CAPABILITIES</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Everything Your Dealership Needs</h2>
        <p class="text-gray-600 text-lg">Eight integrated modules — each purpose-built for equipment dealers, all working together in one system.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '🔧', title: 'Service', desc: 'End-to-end work order management, technician scheduling, warranty tracking, and service history — all in one place. Maximize shop throughput and reduce turnaround times.' },
          { icon: '📱', title: 'Tech Connect', desc: 'Mobile-first tools for service technicians to access work orders, capture time, upload photos, and close jobs from anywhere — even offline.' },
          { icon: '📦', title: 'Parts', desc: 'Real-time parts inventory, automated reordering, bin management, and integration with major supplier catalogs to keep your parts counter running smoothly.' },
          { icon: '🚜', title: 'Rental', desc: 'Complete rental fleet management with contract handling, utilization tracking, billing automation, and maintenance scheduling to maximize asset ROI.' },
          { icon: '🤝', title: 'CRM', desc: 'Customer and prospect management built for dealerships — track interactions, manage opportunities, and stay on top of follow-ups across your entire sales team.' },
          { icon: '💼', title: 'Finance & Accounting', desc: 'Native NetSuite accounting with dealer-specific workflows — AP, AR, general ledger, and financial reporting tailored to equipment dealer operations.' },
          { icon: '⏱️', title: 'Time & Timeclock', desc: 'Accurate labor tracking for shop and field technicians, integrated directly with payroll and job costing to eliminate manual time entry and discrepancies.' },
          { icon: '✨', title: 'Platform & AI', desc: 'The intelligence layer powering DealerCloud — with built-in AI tools, workflow automation, and real-time dashboards that surface insights across every department.' },
          { icon: '🛒', title: 'eCommerce & BI', desc: 'Sell parts and equipment online with an integrated eCommerce storefront, backed by business intelligence reporting to track performance across your entire operation.' },
        ].map(item => (
          <div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
            <div class="text-3xl mb-4">{item.icon}</div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0D1235] text-white py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-wider mb-4">READY TO SEE IT IN ACTION?</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-6">See DealerCloud in Action</h2>
      <p class="text-gray-300 text-lg mb-10">Learn how DealerCloud can unify your dealership operations and deliver measurable results from day one.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://dealercloud.io" target="_blank" rel="noopener noreferrer"
          class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded transition-colors">
          Visit DealerCloud
        </a>
        <a href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session" target="_blank" rel="noopener noreferrer"
          class="border border-white text-white hover:bg-white hover:text-[#0D1235] font-semibold px-8 py-4 rounded transition-colors">
          Request a Demo
        </a>
      </div>
    </div>
  </section>

</Layout>
