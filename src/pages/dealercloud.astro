---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DealerCloud DMS | Inscio">
  <!-- Hero Section -->
  <section class="bg-[#0D1235] text-white py-24 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <div class="inline-block bg-blue-600 text-white text-sm font-semibold px-4 py-2 rounded-full mb-6 uppercase tracking-widest">
        DealerCloud DMS
      </div>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight mb-8 max-w-3xl mx-auto">
        The All-In-One DMS Built for Equipment Dealers
      </h1>
      <p class="text-xl md:text-2xl text-blue-200 max-w-2xl mx-auto mb-10">
        Purpose-built for equipment dealers. DealerCloud connects every part of your business — from service and parts to rentals, finance, and beyond.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-block bg-white text-[#0D1235] font-bold px-8 py-4 rounded-lg text-lg hover:bg-blue-50 transition-colors">
          Request a Demo
        </a>
        <a href="#capabilities" class="inline-block border-2 border-white text-white font-bold px-8 py-4 rounded-lg text-lg hover:bg-white hover:text-[#0D1235] transition-colors">
          Explore Capabilities
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="bg-blue-600 text-white py-16 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
      <div>
        <div class="text-5xl font-extrabold mb-2">300%</div>
        <div class="text-lg text-blue-100">Average ROI</div>
      </div>
      <div>
        <div class="text-5xl font-extrabold mb-2">$500K</div>
        <div class="text-lg text-blue-100">Annual Benefit Delivered</div>
      </div>
      <div>
        <div class="text-5xl font-extrabold mb-2">16 mo</div>
        <div class="text-lg text-blue-100">Average Payback Period</div>
      </div>
    </div>
  </section>

  <!-- What is DealerCloud Section -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-[#0D1235] mb-6">Built From the Ground Up for Equipment Dealers</h2>
      <p class="text-lg text-gray-600 mb-6">
        DealerCloud is a modern dealer management system designed exclusively for equipment dealers. Whether you sell, rent, or service construction, agriculture, or industrial equipment, DealerCloud gives you a single platform to manage it all.
      </p>
      <p class="text-lg text-gray-600">
        Inscio is a certified DealerCloud partner. We implement, configure, and support DealerCloud deployments so you get up and running fast — and get the most out of your investment over time.
      </p>
    </div>
  </section>

  <!-- Capabilities Section -->
  <section id="capabilities" class="py-20 px-6 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-bold text-[#0D1235] mb-4">Everything Your Dealership Needs</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Nine integrated modules cover every corner of your dealership operations.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">Service</h3>
          <p class="text-gray-600">Manage work orders, technician scheduling, warranty claims, and service history — all in one place. Reduce downtime and increase first-time fix rates.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">Tech Connect</h3>
          <p class="text-gray-600">Connect field technicians to the office with mobile tools for time tracking, parts requests, customer signatures, and real-time job updates.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">Parts</h3>
          <p class="text-gray-600">Manage inventory, automate reorder points, handle multi-location stock, and keep your parts counter running efficiently with full visibility into availability and cost.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">Rental</h3>
          <p class="text-gray-600">Run a profitable rental operation with contract management, equipment availability calendars, utilization tracking, billing automation, and damage assessments.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">CRM</h3>
          <p class="text-gray-600">Track leads, manage customer relationships, log interactions, and give your sales team the tools to close more deals and grow accounts over time.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">Finance & Accounting</h3>
          <p class="text-gray-600">Full general ledger, accounts payable/receivable, payroll integration, and financial reporting built specifically for dealer operations — no workarounds needed.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">Time & Timeclock</h3>
          <p class="text-gray-600">Track employee hours, manage job costing, and integrate with payroll. Give your team an easy way to clock in and out from anywhere — shop floor or field.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">Platform & AI</h3>
          <p class="text-gray-600">DealerCloud's modern cloud platform includes AI-powered insights, predictive maintenance alerts, and automation tools that reduce manual work and surface what matters.</p>
        </div>
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-[#0D1235] mb-3">eCommerce & BI</h3>
          <p class="text-gray-600">Sell parts and equipment online with a built-in eCommerce storefront, and make smarter decisions with real-time business intelligence dashboards and reports.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Inscio for DealerCloud -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-4xl font-bold text-[#0D1235] mb-4">Why Implement DealerCloud with Inscio?</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          A great platform only delivers results when it's implemented well. Inscio brings deep dealer industry expertise and a proven methodology to every DealerCloud engagement.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="flex gap-5">
          <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold">1</div>
          <div>
            <h3 class="text-xl font-bold text-[#0D1235] mb-2">Dealer Industry Expertise</h3>
            <p class="text-gray-600">We understand the unique workflows of equipment dealers — from multi-branch parts inventory to complex rental contracts. We configure DealerCloud to match how you actually operate.</p>
          </div>
        </div>
        <div class="flex gap-5">
          <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold">2</div>
          <div>
            <h3 class="text-xl font-bold text-[#0D1235] mb-2">Fast Time to Value</h3>
            <p class="text-gray-600">Our structured implementation process gets you live quickly without cutting corners. We've refined our approach across dozens of deployments to eliminate the surprises that slow projects down.</p>
          </div>
        </div>
        <div class="flex gap-5">
          <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold">3</div>
          <div>
            <h3 class="text-xl font-bold text-[#0D1235] mb-2">Training & Adoption</h3>
            <p class="text-gray-600">Software only works if your team uses it. We build training programs tailored to each role — service writers, technicians, parts staff, and managers — so adoption sticks.</p>
          </div>
        </div>
        <div class="flex gap-5">
          <div class="flex-shrink-0 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold">4</div>
          <div>
            <h3 class="text-xl font-bold text-[#0D1235] mb-2">Ongoing Support</h3>
            <p class="text-gray-600">Our relationship doesn't end at go-live. Inscio provides ongoing support, system optimization, and strategic guidance as your dealership grows and evolves.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-[#0D1235] text-white py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to Modernize Your Dealership?</h2>
      <p class="text-xl text-blue-200 mb-10">
        Let's talk about whether DealerCloud is the right fit for your operation. We'll walk you through the platform and show you what's possible.
      </p>
      <a href="/contact" class="inline-block bg-white text-[#0D1235] font-bold px-10 py-4 rounded-lg text-lg hover:bg-blue-50 transition-colors">
        Schedule a Discovery Call
      </a>
    </div>
  </section>
</Layout>
