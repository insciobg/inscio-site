---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    icon: '🔍',
    title: 'Evaluation & Licensing',
    description: 'We help you determine if NetSuite is the right fit, build the business case, and negotiate licensing to get you the best deal.',
    href: '/services#evaluation',
  },
  {
    icon: '⚙️',
    title: 'Implementation',
    description: 'Expert-led NetSuite implementations on time and on budget — with a process built from dozens of successful projects.',
    href: '/services#implementation',
  },
  {
    icon: '📈',
    title: 'Optimization',
    description: 'Already on NetSuite? We identify gaps, fix workflows, and unlock features you are not using so you get full ROI.',
    href: '/services#optimization',
  },
  {
    icon: '🤝',
    title: 'Support & Training',
    description: 'Ongoing support plans and user training to keep your team confident and your system running smoothly.',
    href: '/services#support',
  },
];

const stats = [
  { value: '150+', label: 'NetSuite Projects' },
  { value: '98%', label: 'Client Satisfaction' },
  { value: '12+', label: 'Years Experience' },
  { value: '40+', label: 'Industries Served' },
];

const testimonials = [
  {
    quote: 'Inscio made our NetSuite implementation smooth and stress-free. Their expertise saved us months of work.',
    author: 'CFO, Manufacturing Company',
  },
  {
    quote: 'We tried another partner first. Switching to Inscio was the best decision we made. Night and day difference.',
    author: 'VP Operations, Distribution Co.',
  },
  {
    quote: 'Brian and the team truly understand both the technology and the business side. Rare combination.',
    author: 'CEO, Professional Services Firm',
  },
];
---

<Layout
  title="Inscio | NetSuite Experts"
  description="Inscio is a NetSuite Alliance Partner helping growing businesses evaluate, implement, optimize, and get maximum value from NetSuite ERP."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1A1F36] to-[#2d3561] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl">
        <p class="section-eyebrow text-blue-400">NetSuite Alliance Partner</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          NetSuite experts who make your ERP work for you
        </h1>
        <p class="text-lg sm:text-xl text-gray-300 mb-10 leading-relaxed">
          From evaluation and licensing through implementation, optimization, and ongoing support — Inscio is the partner that grows with your business.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
            target="_blank"
            rel="noopener"
            class="btn-white"
          >
            Book a Free Strategy Call
          </a>
          <a href="/services" class="btn-secondary border-white text-white hover:bg-white hover:text-blue-800">
            See Our Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-blue-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {stats.map((stat) => (
          <div>
            <p class="text-4xl font-bold mb-1">{stat.value}</p>
            <p class="text-blue-200 text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="section-eyebrow">What We Do</p>
        <h2 class="section-heading">End-to-end NetSuite services</h2>
        <p class="mt-4 text-gray-500 max-w-2xl mx-auto">
          Whether you are evaluating NetSuite for the first time or looking to get more out of an existing system, we have the expertise to help.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((svc) => (
          <a href={svc.href} class="card group hover:border-blue-200">
            <div class="text-3xl mb-4">{svc.icon}</div>
            <h3 class="font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
              {svc.title}
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed">{svc.description}</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/services" class="btn-primary">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Why Inscio -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="section-eyebrow">Why Inscio</p>
          <h2 class="section-heading mb-6">We have done this hundreds of times</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-sm">1</div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">No junior consultants learning on your dime</h3>
                <p class="text-sm text-gray-500">Your project is led by experienced NetSuite practitioners, not entry-level staff.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-sm">2</div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">Fixed-scope options so you know your cost upfront</h3>
                <p class="text-sm text-gray-500">Use our project estimator to get a realistic budget range before any commitment.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-sm">3</div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">We stay after go-live</h3>
                <p class="text-sm text-gray-500">Our support plans mean you always have an expert on call, not just during implementation.</p>
              </div>
            </div>
          </div>
          <div class="mt-8 flex gap-4">
            <a href="/about" class="btn-primary">Meet the Team</a>
            <a href="/estimator" class="btn-secondary">Try the Estimator</a>
          </div>
        </div>
        <div class="bg-[#1A1F36] rounded-2xl p-8 text-white">
          <p class="text-blue-400 font-semibold text-sm uppercase tracking-wider mb-6">Quick Links</p>
          <div class="space-y-4">
            <a href="/estimator" class="flex items-center gap-4 p-4 bg-white/10 rounded-xl hover:bg-white/20 transition-colors">
              <span class="text-2xl">🧮</span>
              <div>
                <p class="font-semibold">Project Estimator</p>
                <p class="text-sm text-gray-400">Get a budget estimate in minutes</p>
              </div>
            </a>
            <a href="/videos" class="flex items-center gap-4 p-4 bg-white/10 rounded-xl hover:bg-white/20 transition-colors">
              <span class="text-2xl">🎥</span>
              <div>
                <p class="font-semibold">Video Library</p>
                <p class="text-sm text-gray-400">Watch NetSuite explainer videos</p>
              </div>
            </a>
            <a href="/library" class="flex items-center gap-4 p-4 bg-white/10 rounded-xl hover:bg-white/20 transition-colors">
              <span class="text-2xl">📚</span>
              <div>
                <p class="font-semibold">Resource Library</p>
                <p class="text-sm text-gray-400">Fact sheets, guides & templates</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="section-eyebrow">Client Stories</p>
        <h2 class="section-heading">What our clients say</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <div class="bg-gray-50 rounded-2xl p-8">
            <div class="text-blue-400 text-4xl mb-4">"</div>
            <p class="text-gray-700 leading-relaxed mb-6">{t.quote}</p>
            <p class="text-sm font-semibold text-gray-500">{t.author}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-blue-600 text-white py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Ready to get more from NetSuite?</h2>
      <p class="text-blue-200 mb-8 text-lg">
        Book a free 30-minute strategy call. No pressure, no sales pitch — just expert advice.
      </p>
      <a
        href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
        target="_blank"
        rel="noopener"
        class="btn-white"
      >
        Book Your Free Call
      </a>
    </div>
  </section>
</Layout>
