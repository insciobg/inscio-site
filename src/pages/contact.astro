---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact Inscio | NetSuite Consulting"
  description="Talk to Inscio's NetSuite team. 972-521-7324 · info@inscio.com · Plano, TX. Schedule a free strategy call or send us a message."
>

  <!-- Hero -->
  <section class="bg-[#0D1235] text-white py-28 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">CONTACT</p>
      <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">
        Start the conversation.
      </h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed">
        Whether you're evaluating NetSuite, stuck on a problem, or just want to know if we're the right fit — we'd love to hear from you.
      </p>
    </div>
  </section>

  <!-- Contact Grid -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16">

      <!-- Contact Info -->
      <div>
        <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-8">GET IN TOUCH</p>

        <div class="space-y-6 mb-10">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">Phone</p>
              <a href="tel:9725217324" class="text-lg font-semibold text-gray-900 hover:text-blue-600 transition-colors">972-521-7324</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">Email</p>
              <a href="mailto:info@inscio.com" class="text-lg font-semibold text-gray-900 hover:text-blue-600 transition-colors">info@inscio.com</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">Office</p>
              <p class="text-lg font-semibold text-gray-900">5830 Granite Pkwy, Suite 100</p>
              <p class="text-gray-600">Plano, TX 75024</p>
            </div>
          </div>
        </div>

        <!-- Quick trust signals -->
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
          <p class="text-sm font-semibold text-gray-900 mb-4">What to expect when you reach out:</p>
          <ul class="space-y-2">
            {[
              'Response within one business day',
              'Free 30-minute strategy call — no commitment required',
              'Honest assessment of whether NetSuite is the right fit',
            ].map(item => (
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <span class="text-blue-600 font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Partner credentials -->
        <div class="mt-8 pt-6 border-t border-gray-100">
          <p class="text-xs uppercase tracking-wider text-gray-400 mb-4">Partner Status &amp; Recognition</p>
          <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
            <img src="/images/logos/oracle-netsuite-solution-provider.png" alt="Oracle NetSuite Solution Provider" class="h-12 w-auto object-contain" />
            <img src="/images/logos/oracle-netsuite-suitecloud-developer.png" alt="Oracle NetSuite SuiteCloud Developer Network" class="h-12 w-auto object-contain" />
            <img src="/images/logos/inc-5000.png" alt="Inc. 5000 Honoree 2x" class="h-12 w-auto object-contain" />
          </div>
        </div>
      </div>

      <!-- Schedule / Form -->
      <div>
        <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-4">SCHEDULE A CALL</p>
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Book a free strategy session</h2>
        <p class="text-gray-600 text-lg mb-8">
          The fastest way to get started is a 30-minute call with our team. We'll listen, ask the right questions, and tell you honestly what we think — no pitch deck required.
        </p>
        <a
          href="javascript:void(0)" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session?hide_gdpr_banner=1'});return false;"
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded transition-colors mb-12 text-lg"
        >
          Book a Free Call →
        </a>

        <div class="border-t border-gray-100 pt-10">
          <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-4">SEND A MESSAGE</p>
          <h3 class="text-xl font-bold text-gray-900 mb-6">Prefer to write? We'll get back to you within one business day.</h3>

          <!-- Success banner (shown when ?sent=1 is in the URL) -->
          <div id="form-success" class="hidden mb-6 bg-green-50 border border-green-200 rounded-lg p-5">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <p class="font-semibold text-green-800">Message sent!</p>
                <p class="text-green-700 text-sm mt-1">Thanks for reaching out. We'll get back to you within one business day.</p>
              </div>
            </div>
          </div>

          <!-- Error banner (shown when ?error=1 is in the URL) -->
          <div id="form-error" class="hidden mb-6 bg-red-50 border border-red-200 rounded-lg p-5">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <p class="font-semibold text-red-800">Something went wrong.</p>
                <p class="text-red-700 text-sm mt-1">Your message couldn't be sent. Please email us directly at <a href="mailto:info@inscio.com" class="underline">info@inscio.com</a> or call 972-521-7324.</p>
              </div>
            </div>
          </div>

          <form
            id="contact-form"
            action="https://formspree.io/f/xykvypnl"
            method="POST"
            class="space-y-5"
          >
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="first-name">First Name</label>
                <input id="first-name" name="first-name" type="text" required
                  class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                  placeholder="Jane" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="last-name">Last Name</label>
                <input id="last-name" name="last-name" type="text" required
                  class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                  placeholder="Smith" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Work Email</label>
              <input id="email" name="email" type="email" required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                placeholder="jane@company.com" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="company">Company</label>
              <input id="company" name="company" type="text"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                placeholder="Acme Corp" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="message">How can we help?</label>
              <textarea id="message" name="message" rows="4" required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"
                placeholder="Tell us what you're working on or where you're stuck..."></textarea>
            </div>

            <button id="contact-submit-btn" type="submit"
              class="w-full bg-[#0D1235] hover:bg-[#1a2050] text-white font-semibold px-8 py-4 rounded transition-colors">
              Send Message
            </button>
          </form>
        </div>
      </div>

    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
    const successBanner = document.getElementById('form-success') as HTMLElement;
    const errorBanner = document.getElementById('form-error') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      errorBanner.classList.add('hidden');

      try {
        const res = await fetch('https://formspree.io/f/xykvypnl', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form),
        });

        if (res.ok) {
          form.classList.add('hidden');
          successBanner.classList.remove('hidden');
          if (typeof gtag !== 'undefined') gtag('event', 'generate_lead', { event_category: 'contact_form', event_label: 'Contact Page' });
        } else {
          throw new Error('submission failed');
        }
      } catch (_) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
        errorBanner.classList.remove('hidden');
      }
    });
  </script>

</Layout>
