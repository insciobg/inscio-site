---
import Layout from '../layouts/Layout.astro';

const cards = [
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="4" y1="9" x2="20" y2="9"/><line x1="9" y1="2" x2="9" y2="9"/><circle cx="8" cy="14" r="0.5" fill="currentColor"/><circle cx="12" cy="14" r="0.5" fill="currentColor"/><circle cx="16" cy="14" r="0.5" fill="currentColor"/><circle cx="8" cy="18" r="0.5" fill="currentColor"/><circle cx="12" cy="18" r="0.5" fill="currentColor"/><circle cx="16" cy="18" r="0.5" fill="currentColor"/></svg>`,
    title: 'NetSuite Project Estimator',
    description: 'Get a realistic budget range for your NetSuite implementation in minutes. Answer a few questions about your business and we will generate a scope and cost estimate.',
    href: '/estimator',
    cta: 'Start Estimating',
    badge: 'Free Tool',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>`,
    title: 'Video Library',
    description: 'Short, practical videos explaining how NetSuite works, how to evaluate it, and what to expect during implementation. No fluff, no sales pitch.',
    href: '/videos',
    cta: 'Watch Videos',
    badge: 'Free',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
    title: 'Resource Library',
    description: 'Fact sheets, checklists, comparison guides, and templates to help you make informed decisions about NetSuite and your ERP journey.',
    href: '/library',
    cta: 'Browse Library',
    badge: 'Free Download',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`,
    title: 'Blog',
    description: 'In-depth articles on NetSuite features, implementation best practices, industry-specific tips, and lessons learned from 150+ projects.',
    href: '/blog',
    cta: 'Read Articles',
    badge: 'Free',
  },
  {
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Customer Stories',
    description: 'Real NetSuite implementations, told honestly. See how companies like yours recovered from failed ERPs, unified their operations, and built systems that actually grew with them.',
    href: '/case-studies',
    cta: 'Read Stories',
    badge: 'New',
  },
];
---

<Layout
  title="NetSuite Resources | Inscio"
  description="Free NetSuite resources from Inscio: project estimator, video library, fact sheets, and blog articles to help you succeed with NetSuite ERP."
>
  <!-- Hero -->
  <section class="bg-[#0D1235] text-white py-28 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">RESOURCES</p>
      <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">Everything you need to succeed with NetSuite.</h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed">
        Free tools, videos, and guides to help you evaluate, implement, and optimize NetSuite — whether you're a prospect or an existing customer.
      </p>
    </div>
  </section>

  <!-- Resource Cards -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {cards.map((card) => (
          <div class="card flex flex-col">
            <div class="flex items-start justify-between mb-4">
              <span class="text-blue-600" set:html={card.icon} />
              <span class="bg-blue-100 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full">{card.badge}</span>
            </div>
            <h2 class="text-xl font-bold text-gray-900 mb-3">{card.title}</h2>
            <p class="text-gray-500 leading-relaxed flex-1 mb-6">{card.description}</p>
            <a href={card.href} class="btn-primary self-start">{card.cta} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-heading mb-4">Still have questions?</h2>
      <p class="text-gray-500 mb-8">Book a free strategy call and get answers from a real NetSuite expert.</p>
      <a
        href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
        target="_blank"
        rel="noopener"
        class="btn-primary"
      >
        Book a Free Strategy Call
      </a>
    </div>
  </section>
</Layout>
