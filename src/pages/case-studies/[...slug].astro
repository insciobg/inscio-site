---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('case-studies', ({ data }) => !data.draft);
  return stories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await story.render();
const { data } = story;
---

<Layout
  title={`${data.company} | Customer Story | Inscio`}
  description={data.intro}
>
  <!-- Hero -->
  <section class="bg-[#0D1235] text-white py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <a href="/case-studies/" class="text-blue-400 text-sm hover:text-blue-300 transition-colors inline-flex items-center gap-1 mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Customer Stories
      </a>
      <p class="text-blue-400 text-xs font-semibold uppercase tracking-widest mb-3">{data.industries[0]}</p>
      <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-4 max-w-4xl">{data.title}</h1>
      <p class="text-gray-300 text-lg max-w-2xl">{data.subheading}</p>
    </div>
  </section>

  <!-- Content + Sidebar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-3 gap-12 items-start">

      <!-- Article -->
      <article class="lg:col-span-2">
        <div class="prose-inscio">
          <Content />
        </div>

        <!-- Bottom CTA -->
        <div class="mt-14 bg-gray-50 border border-gray-200 rounded-xl p-8">
          <p class="text-xl font-bold text-gray-900 mb-3">{data.ctaHeadline}</p>
          <p class="text-gray-600 mb-6">{data.ctaBody}</p>
          <a
            href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded transition-colors"
          >
            Schedule a Free Strategy Call
          </a>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-1 flex flex-col gap-6 lg:sticky lg:top-24">

        <!-- Stats -->
        <div class="bg-[#0D1235] text-white rounded-2xl p-6">
          <div class="mb-5">
            <div class="text-4xl font-extrabold text-blue-400 leading-none mb-1">{data.stat1Value}</div>
            <div class="font-bold text-white">{data.stat1Label}</div>
            <div class="text-gray-400 text-sm mt-0.5">{data.stat1Sub}</div>
          </div>
          <div class="border-t border-white/20 pt-5">
            <div class="text-4xl font-extrabold text-blue-400 leading-none mb-1">{data.stat2Value}</div>
            <div class="font-bold text-white">{data.stat2Label}</div>
            <div class="text-gray-400 text-sm mt-0.5">{data.stat2Sub}</div>
          </div>
        </div>

        <!-- CTA -->
        <div class="bg-[#0D1235] text-white rounded-2xl p-6">
          <p class="font-bold text-lg mb-2">Get expert advice</p>
          <p class="text-gray-300 text-sm mb-5">Book a free 30-minute call with a NetSuite expert. No sales pitch.</p>
          <a
            href="https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-3 rounded transition-colors"
          >
            Book a Free Strategy Call
          </a>
        </div>

        <!-- Quick Tools -->
        <div class="bg-gray-50 rounded-2xl p-6">
          <p class="font-bold text-gray-900 mb-4">Quick Tools</p>
          <ul class="flex flex-col gap-3">
            <li>
              <a href="/estimator" class="flex items-center gap-3 text-gray-600 hover:text-blue-600 transition-colors text-sm">
                <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="4" y1="9" x2="20" y2="9"/><line x1="9" y1="2" x2="9" y2="9"/></svg>
                Project Estimator
              </a>
            </li>
            <li>
              <a href="/videos/" class="flex items-center gap-3 text-gray-600 hover:text-blue-600 transition-colors text-sm">
                <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
                Video Library
              </a>
            </li>
            <li>
              <a href="/library/" class="flex items-center gap-3 text-gray-600 hover:text-blue-600 transition-colors text-sm">
                <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Resource Library
              </a>
            </li>
          </ul>
        </div>

        <!-- Tags -->
        <div class="flex flex-col gap-5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Software Replaced</p>
            <div class="flex flex-wrap gap-2">
              {data.softwareReplaced.map(tag => (
                <span class="bg-gray-100 text-gray-600 text-xs font-medium px-3 py-1 rounded-full">{tag}</span>
              ))}
            </div>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Industry</p>
            <div class="flex flex-wrap gap-2">
              {data.industries.map(tag => (
                <span class="bg-blue-50 text-blue-700 text-xs font-medium px-3 py-1 rounded-full">{tag}</span>
              ))}
            </div>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Modules Implemented</p>
            <div class="flex flex-wrap gap-2">
              {data.modules.map(tag => (
                <span class="bg-gray-100 text-gray-600 text-xs font-medium px-3 py-1 rounded-full">{tag}</span>
              ))}
            </div>
          </div>
        </div>

      </aside>
    </div>
  </div>
</Layout>

<style>
  .prose-inscio p {
    color: #4b5563;
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }
  .prose-inscio h3 {
    color: #111827;
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
</style>
