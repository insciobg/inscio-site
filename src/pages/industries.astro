---
import Layout from '../layouts/Layout.astro';
const industries = [
  {
    id: 'distribution',
    letter: 'D',
    title: 'Wholesale Distribution',
    subtitle: 'Turn Inventory Complexity into Competitive Advantage',
    body: 'Distributors live and die by inventory accuracy, fill rates, and margin management. Yet most ERPs force spreadsheet workarounds the moment you add a second warehouse. Inscio configures NetSuite so your system reflects the way distribution actually works.',
    cta: 'Get a Distribution Assessment',
    bullets: [
      'Real-time inventory across all locations',
      'Demand-driven replenishment, fewer stockouts',
      'Automated POs with supplier portals',
      'Intelligent pick/pack/ship with fewer errors',
      'Multi-location inventory with bin-level tracking',
      'EDI and 3PL integrations built in',
    ],
  },
  {
    id: 'manufacturing',
    letter: 'M',
    title: 'Manufacturing',
    subtitle: 'Real-Time Shop Floor Visibility',
    body: "Most manufacturers run operations on one system and financials on another. When those systems don't talk, you can't quote accurately, see true cost of goods, or promise delivery dates with confidence.",
    cta: 'Get a Manufacturing Assessment',
    bullets: [
      'Work orders linked to real-time material availability',
      'Accurate cost of goods with full BOM visibility',
      'Production schedules that reflect actual capacity',
      'Quality and compliance built into every workflow',
      'Shop floor to financial reporting in one system',
      'Routing, scheduling, and WIP tracking',
    ],
  },
  {
    id: 'energy',
    letter: 'E',
    title: 'Energy',
    subtitle: 'Manage Complex Projects Across Sites and Jurisdictions',
    body: 'Energy businesses face a uniquely complex mix of field operations, project accounting, regulatory reporting, and multi-entity structures. Inscio deploys NetSuite to bring all of it together from field service dispatch to consolidated financial reporting.',
    cta: 'Get an Energy Assessment',
    bullets: [
      'Project costing and job profitability tracking',
      'Multi-entity and intercompany consolidation',
      'Field service and asset management integration',
      'Regulatory and environmental compliance reporting',
      'Multi-currency and multi-jurisdictional tax handling',
      'Joint venture and production sharing accounting',
    ],
  },
  {
    id: 'dealerships',
    letter: 'EQ',
    title: 'Equipment Dealerships',
    subtitle: 'One System for Every Corner of the Dealership',
    body: "Equipment dealers run some of the most operationally complex businesses in any industry — managing sales, service, rental, parts, and financing across multiple locations and brands. Generic ERPs weren't built for this. DealerCloud was.",
    cta: 'See DealerCloud',
    ctaHref: '/dealercloud',
    bullets: [
      'Service work order management with technician scheduling',
      'Parts inventory with automated reorder and supplier catalog integration',
      'Rental fleet management: contracts, utilization, and billing',
      'Sales and CRM built for equipment sales cycles',
      'Financial consolidation across multiple locations',
      'Mobile tools for service technicians in the field',
    ],
  },
  {
    id: 'hypergrowth',
    letter: 'HG',
    title: 'Hyper-Growth & Scale-Ups',
    subtitle: "ERP Infrastructure for Companies That Can't Afford to Slow Down",
    body: "Rapidly scaling companies outgrow their systems before they realize it. When you're adding entities, acquiring businesses, or expanding into new markets, your ERP needs to keep pace — not become the bottleneck. Inscio deploys NetSuite to give high-growth companies the operational infrastructure to scale without chaos.",
    cta: 'Talk to Our Growth Team',
    bullets: [
      'New entity standup in days, not months',
      'M&A integration with multi-entity consolidation',
      'Intercompany eliminations and consolidated reporting',
      'Automated revenue recognition for complex deal structures',
      'Real-time dashboards built for investor and board reporting',
      'Scalable chart of accounts built for the next phase of growth',
    ],
  },
  {
    id: 'software',
    letter: 'SW',
    title: 'Software & Technology',
    subtitle: 'Run Your Business the Way Investors and Auditors Expect',
    body: "SaaS and technology companies face reporting complexity that most ERPs can't handle out of the box — from ASC 606 revenue recognition to ARR dashboards and subscription billing. Inscio configures NetSuite so your financials are audit-ready and your metrics are always current.",
    cta: 'Schedule a Software & Tech Assessment',
    bullets: [
      'ASC 606 revenue recognition across complex deal structures',
      'Subscription and recurring billing management',
      'ARR, MRR, and churn reporting built into NetSuite',
      'Multi-entity consolidation for SaaS holding structures',
      'Investor and board-level reporting dashboards',
      'Professional services automation for implementation and CS teams',
    ],
  },
];
---
<Layout
  title="NetSuite for Your Industry | Inscio"
  description="Inscio brings deep industry expertise to NetSuite implementations across wholesale distribution, manufacturing, professional services, life sciences, energy, and equipment dealerships."
>

  <!-- Hero -->
  <section class="bg-[#0D1235] text-white py-28 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">NETSUITE FOR YOUR INDUSTRY</p>
      <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">
        NetSuite, Built for Your Industry
      </h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed mb-10">
        Generic ERP implementations fail because every industry has its own rhythms. We've spent two decades learning the ones that matter — distribution, manufacturing, professional services, life sciences, and energy.
      </p>
      <a href="javascript:void(0)" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session?hide_gdpr_banner=1'});return false;"
        class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded transition-colors">
        Schedule a Strategy Call
      </a>
    </div>
  </section>

  <!-- Industry grid overview -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-14">
        <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">DEEP EXPERTISE</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Deep Expertise Where It Counts</h2>
        <p class="text-gray-600 text-lg">Inscio's team includes former operations leaders and NetSuite architects who have lived the challenges of your industry. We don't learn on your dime.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-6 gap-4">
        {industries.map(ind => (
          <a href={`#${ind.id}`} class="bg-gray-50 border border-gray-200 rounded-lg p-6 hover:border-blue-300 hover:shadow-md transition-all group">
            <div class="w-10 h-10 bg-[#0D1235] text-white rounded-full flex items-center justify-center font-bold text-lg mb-4 group-hover:bg-blue-600 transition-colors">{ind.letter}</div>
            <h3 class="font-bold text-gray-900 text-sm">{ind.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry details -->
  {industries.map((ind, i) => (
    <section id={ind.id} class={`py-24 px-4 ${i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}`}>
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-start">
        <div>
          <div class="w-12 h-12 bg-[#0D1235] text-white rounded-full flex items-center justify-center font-bold text-xl mb-6">{ind.letter}</div>
          <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">{ind.title.toUpperCase()}</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{ind.subtitle}</h2>
          <p class="text-gray-600 text-lg leading-relaxed mb-8">{ind.body}</p>
          <a href={ind.ctaHref || 'https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session'} target={ind.ctaHref ? '_self' : '_blank'} rel="noopener noreferrer"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded transition-colors">
            {ind.cta}
          </a>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-8 md:mt-[72px]">
          <ul class="space-y-3">
            {ind.bullets.map(b => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="text-blue-600 font-bold mt-0.5">+</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}


  <!-- Broader Industries -->
  <section class="bg-[#0D1235] text-white py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mb-12">
        <p class="text-blue-400 text-sm font-semibold uppercase tracking-wider mb-3">BROADER REACH</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">We've worked across a wide range of industries.</h2>
        <p class="text-gray-300 text-lg leading-relaxed">Our experience extends well beyond our core verticals. If you're a growth-stage company, a multi-entity organization, or operate in a specialized market, chances are we've worked in your space.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        {[
          { label: 'Professional Services', note: 'Project billing, utilization, revenue recognition' },
          { label: 'Life Sciences', note: 'Biotech, pharma, FDA and GMP compliance' },
          { label: 'Medical Device', note: 'Lot traceability, serialization, 21 CFR Part 11' },
          { label: 'Sports Nutrition & Energy Drinks', note: 'Supplements, functional beverages, D2C and wholesale' },
          { label: 'Consumer Packaged Goods', note: 'Multi-channel, retail, D2C' },
          { label: 'Hospitality', note: 'Multi-location, property-level reporting' },
          { label: 'Multi-Entity & Multinational', note: 'Intercompany, consolidation, multi-currency' },
          { label: 'Private Label Manufacturing', note: 'Contract production, co-manufacturing, multi-SKU ops' },
          { label: 'Industrial & Commercial Services', note: 'Project accounting, field service, job costing' },
          { label: 'Advertising, Digital & Media', note: 'Agency billing, project margins, multi-client reporting' },
          { label: 'Direct to Consumer', note: 'D2C brands, subscription commerce, omnichannel fulfillment' },
          { label: 'PE-Backed Portfolio Companies', note: 'Multi-entity rollups, rapid standup, investor reporting' },
        ].map(ind => (
          <div class="bg-white/10 border border-white/20 rounded-lg p-5">
            <p class="font-semibold text-white mb-1">{ind.label}</p>
            <p class="text-gray-400 text-sm">{ind.note}</p>
          </div>
        ))}
      </div>
      <p class="text-gray-400 text-sm">Don't see your industry? <a href="/contact" class="text-blue-400 hover:text-blue-300 underline">Reach out</a> — if you're running on NetSuite or evaluating it, we've likely seen your challenges before.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-blue-600 py-20 px-4">
    <div class="max-w-3xl mx-auto text-center text-white">
      <p class="text-blue-100 text-sm font-semibold uppercase tracking-wider mb-4">GET STARTED</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to See What Is Possible?</h2>
      <p class="text-blue-100 text-lg mb-10">A great NetSuite implementation is not just about turning on the right modules. It is about configuring workflows that match how your people work, your customers buy, and your business reports.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="javascript:void(0)" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session?hide_gdpr_banner=1'});return false;"
          class="bg-white text-blue-600 font-bold px-8 py-4 rounded hover:bg-blue-50 transition-colors">
          Schedule a Strategy Call
        </a>
        <a href="/services" class="border border-white text-white hover:bg-white hover:text-blue-600 font-semibold px-8 py-4 rounded transition-colors">
          View Our Services
        </a>
      </div>
    </div>
  </section>

</Layout>