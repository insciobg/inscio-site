---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title="NetSuite Blog | Inscio"
  description="In-depth articles on NetSuite implementation, optimization, licensing, and best practices. Written by practitioners with 150+ projects of experience."
>
  <!-- Hero -->
  <section class="bg-[#0D1235] text-white py-28 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">BLOG</p>
      <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">NetSuite insights from the field.</h1>
      <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed">
        Practical insights on NetSuite implementation, optimization, and strategy — written by consultants who have done this hundreds of times.
      </p>
    </div>
  </section>

  <!-- Posts -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <div class="text-center py-20 text-gray-400">
          <p class="text-xl mb-4">Articles coming soon.</p>
          <a href="/resources" class="btn-primary">Browse Other Resources</a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="card group flex flex-col">
              <div class="flex items-center gap-2 mb-3">
                <span class="bg-blue-100 text-blue-700 text-xs font-semibold px-2 py-0.5 rounded-full">
                  {post.data.category}
                </span>
              </div>
              <h2 class="font-bold text-gray-900 text-lg mb-2 group-hover:text-blue-600 transition-colors flex-1">
                {post.data.title}
              </h2>
              <p class="text-sm text-gray-500 leading-relaxed mb-4">{post.data.description}</p>
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
                <span class="text-xs text-gray-400">{formatDate(post.data.pubDate)}</span>
                <span class="text-xs text-gray-400">{post.data.author}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-heading mb-4">Want expert advice for your situation?</h2>
      <p class="text-gray-500 mb-8">Book a free call and we will give you specific, actionable guidance.</p>
      <a
        href="javascript:void(0)" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session?hide_gdpr_banner=1'});return false;"
        target="_blank"
        rel="noopener"
        class="btn-primary"
      >
        Book a Free Strategy Call
      </a>
    </div>
  </section>
</Layout>
