<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script is:inline>
// ── CALCULATOR LOGIC ──────────────────────────────────────────────────────
var FIN_SALARY   = 85000;
var CLOSE_REDUC  = 0.40;
var INV_CARRYING = 0.20;
var INV_OPTIM    = 0.15;
var LABOR_TEAM_MULT = 3;
var GOLIVE_MONTHS  = 6;
var TASK_FRAC    = 0.12;
var PROD_GAIN    = 0.10;
var ERROR_RATE   = 0.003;
var DISCOUNT     = 0.10;

function fmt(n) {
  var abs = Math.abs(n), sign = n < 0 ? '-' : '';
  if (abs >= 1000000) return sign + '$' + (abs / 1000000).toFixed(1) + 'M';
  if (abs >= 1000)    return sign + '$' + Math.round(abs / 1000) + 'K';
  return sign + '$' + Math.round(abs);
}

var roiChart;

function recalc() {
  var revenue     = parseFloat(document.getElementById('revenue').value)      || 0;
  var finTeam     = parseFloat(document.getElementById('fin-team').value)     || 0;
  var closeDays   = parseFloat(document.getElementById('close-days').value)   || 0;
  var inventory   = parseFloat(document.getElementById('inventory').value)    || 0;
  var implCost    = parseFloat(document.getElementById('impl-cost').value)    || 0;
  var licenseCost = parseFloat(document.getElementById('license-cost').value) || 0;

  // Read adjustable assumptions from sliders (if panel exists)
  var asCloseEl = document.getElementById('as-close');
  var asInvEl   = document.getElementById('as-inv');
  var asProdEl  = document.getElementById('as-prod');
  var asErrEl   = document.getElementById('as-err');
  if (asCloseEl) CLOSE_REDUC = parseFloat(asCloseEl.value) / 100;
  if (asInvEl)   INV_OPTIM   = parseFloat(asInvEl.value)   / 100;
  if (asProdEl)  PROD_GAIN   = parseFloat(asProdEl.value)  / 100;
  if (asErrEl)   ERROR_RATE  = parseFloat(asErrEl.value)   / 100;

  // Labels
  document.getElementById('fin-team-out').textContent  = Math.round(finTeam);
  document.getElementById('close-days-out').textContent = Math.round(closeDays);
  var revLabel = revenue >= 1e6 ? '$' + (revenue / 1e6).toFixed(1) + 'M' : '$' + Math.round(revenue / 1000) + 'K';
  document.getElementById('revenue-display').textContent = revLabel;

  // Benefit drivers
  var closeMonthFrac = closeDays / 21;
  var finClose       = finTeam * FIN_SALARY * closeMonthFrac * CLOSE_REDUC;
  var invSaving      = inventory * INV_CARRYING * INV_OPTIM;
  var laborSaving    = finTeam * LABOR_TEAM_MULT * FIN_SALARY * TASK_FRAC * PROD_GAIN;
  var errorSaving    = Math.min(revenue * ERROR_RATE, 150000);
  var totalAnnual    = finClose + invSaving + laborSaving + errorSaving;

  // Payback
  var monthlyNet = (totalAnnual - licenseCost) / 12;
  var payback = 0;
  var cum = -implCost;
  for (var m = 1; m <= 72; m++) {
    if (m > GOLIVE_MONTHS) cum += monthlyNet;
    if (cum >= 0 && payback === 0) { payback = m; break; }
  }

  // 3-year ROI
  var totalCost3 = implCost + licenseCost * 3;
  var net3       = totalAnnual * 3 - totalCost3;
  var roi        = totalCost3 > 0 ? Math.round((net3 / totalCost3) * 100) : 0;

  // NPV
  var annualNet = totalAnnual - licenseCost;
  var npv = -implCost;
  npv += annualNet * (1 - GOLIVE_MONTHS / 12) / Math.pow(1 + DISCOUNT, 1);
  npv += annualNet / Math.pow(1 + DISCOUNT, 2);
  npv += annualNet / Math.pow(1 + DISCOUNT, 3);

  // Update metric cards
  document.getElementById('annual-benefit').textContent = fmt(totalAnnual);
  document.getElementById('payback').textContent = payback > 0 ? payback + ' mo' : '>72 mo';

  // Payback quality label
  var pbLabelEl = document.getElementById('payback-label');
  if (pbLabelEl) {
    var qlabel = '', qcolor = '';
    if      (payback > 0 && payback <= 18) { qlabel = 'Exceptional'; qcolor = '#059669'; }
    else if (payback > 0 && payback <= 30) { qlabel = 'Strong';      qcolor = '#2563EB'; }
    else if (payback > 0 && payback <= 42) { qlabel = 'Acceptable';  qcolor = '#D97706'; }
    else if (payback > 0)                  { qlabel = 'Extended';    qcolor = '#DC2626'; }
    pbLabelEl.textContent = qlabel;
    pbLabelEl.style.color = qcolor;
  }

  var roiEl = document.getElementById('roi-pct');
  roiEl.textContent = roi + '%';
  roiEl.style.color = roi >= 0 ? '#059669' : '#DC2626';

  var npvEl = document.getElementById('npv');
  npvEl.textContent = fmt(npv);
  npvEl.style.color = npv >= 0 ? '#059669' : '#DC2626';

  // Breakdown bars
  var items = [
    { name: 'Finance close efficiency', value: finClose,    color: '#2563EB' },
    { name: 'Inventory optimization',   value: invSaving,   color: '#059669' },
    { name: 'Labor productivity',       value: laborSaving, color: '#7C3AED' },
    { name: 'Error & rework reduction', value: errorSaving, color: '#D97706' },
  ];
  var maxVal = Math.max.apply(null, items.map(function(i) { return i.value; }));
  if (maxVal < 1) maxVal = 1;
  document.getElementById('breakdown').innerHTML = items.map(function(it) {
    return '<div class="mb-2.5">' +
      '<div class="flex justify-between text-[12px] mb-1">' +
        '<span class="text-gray-500">' + it.name + '</span>' +
        '<span class="font-semibold text-[#1A1F36]">' + fmt(it.value) + '</span>' +
      '</div>' +
      '<div class="w-full bg-gray-100 rounded" style="height:5px">' +
        '<div class="breakdown-bar" style="width:' + Math.round((it.value / maxVal) * 100) + '%; background:' + it.color + ';"></div>' +
      '</div>' +
    '</div>';
  }).join('');

  // Chart
  var pts = [];
  for (var i = 0; i <= 36; i++) {
    if (i <= GOLIVE_MONTHS) pts.push(-implCost);
    else pts.push(Math.round(-implCost + monthlyNet * (i - GOLIVE_MONTHS)));
  }
  var labels = [];
  for (var j = 0; j <= 36; j++) {
    labels.push(j % 6 === 0 ? (j === 0 ? 'Now' : j + ' mo') : '');
  }

  if (roiChart) {
    roiChart.data.labels = labels;
    roiChart.data.datasets[0].data = pts;
    roiChart.update('none');
  } else {
    roiChart = new Chart(document.getElementById('roiChart').getContext('2d'), {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          data: pts,
          borderColor: '#2563EB',
          backgroundColor: 'rgba(37,99,235,0.06)',
          fill: true,
          tension: 0.35,
          pointRadius: 0,
          borderWidth: 2,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: function(c) { return fmt(c.raw); } } }
        },
        scales: {
          x: { grid: { display: false }, ticks: { font: { size: 10 }, color: '#9CA3AF', maxRotation: 0 } },
          y: { grid: { color: 'rgba(0,0,0,0.04)' }, ticks: { font: { size: 10 }, color: '#9CA3AF', callback: function(v) { return fmt(v); } } }
        }
      }
    });
  }
}

// Wire inputs
['revenue', 'fin-team', 'close-days', 'inventory', 'impl-cost', 'license-cost'].forEach(function(id) {
  document.getElementById(id).addEventListener('input', recalc);
});

// Assumption sliders: sync display labels and retrigger recalc
['as-close', 'as-inv', 'as-prod', 'as-err'].forEach(function(id) {
  var el = document.getElementById(id);
  if (!el) return;
  el.addEventListener('input', function() {
    var v = parseFloat(el.value);
    var display = id === 'as-err' ? v.toFixed(1) + '%' : Math.round(v) + '%';
    var valEl = document.getElementById(id + '-val');
    var lblEl = document.getElementById(id + '-lbl');
    if (valEl) valEl.textContent = display;
    if (lblEl) lblEl.textContent = display;
    recalc();
  });
});

// Toggle assumptions panel
var toggleBtn = document.getElementById('assumptions-toggle');
var assPanel  = document.getElementById('assumptions-panel');
if (toggleBtn && assPanel) {
  toggleBtn.addEventListener('click', function() {
    var isHidden = assPanel.classList.contains('hidden');
    assPanel.classList.toggle('hidden', !isHidden);
    toggleBtn.textContent = isHidden ? '\u25c2 Close' : 'Adjust \u25ba';
  });
}

// Reset assumptions to defaults
var resetBtn = document.getElementById('assumptions-reset');
if (resetBtn) {
  resetBtn.addEventListener('click', function() {
    var defaults = {'as-close': '40', 'as-inv': '15', 'as-prod': '10', 'as-err': '0.3'};
    Object.keys(defaults).forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.value = defaults[id];
      var v = parseFloat(defaults[id]);
      var display = id === 'as-err' ? v.toFixed(1) + '%' : Math.round(v) + '%';
      var valEl = document.getElementById(id + '-val');
      var lblEl = document.getElementById(id + '-lbl');
      if (valEl) valEl.textContent = display;
      if (lblEl) lblEl.textContent = display;
    });
    recalc();
  });
}

recalc();
</script>

