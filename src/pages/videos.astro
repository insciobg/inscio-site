---

<Layout
  title="NetSuite Videos: Inscio U Explainers and Product Demos | Inscio"
  description="Short Inscio U explainers on NetSuite and AI, plus NetSuite product demos covering financials, analytics, supply chain, CRM, integrations, and industry solutions."
  ogImage="https://inscio.com/images/og/inscio-u-system-underneath-ai.jpg"
>

<style is:inline>
.video-thumb {
  position: relative;
  cursor: pointer;
  border-radius: 0.75rem;
  overflow: hidden;
  aspect-ratio: 16/9;
  background: #000;
}
.video-thumb img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: opacity 0.2s;
}
.video-thumb:hover img { opacity: 0.8; }
.play-btn {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.play-btn svg { width: 52px; height: 52px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5)); transition: transform 0.2s; }
.video-thumb:hover .play-btn svg { transform: scale(1.12); }

/* Lightbox */
#video-lightbox {
  display: none;
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(0,0,0,0.85);
  align-items: center; justify-content: center;
  padding: 1rem;
}
#video-lightbox.open { display: flex; }
#lightbox-inner {
  position: relative;
  width: 100%; max-width: 960px;
  aspect-ratio: 16/9;
}
#lightbox-video {
  display: none;
  width: 100%; height: 100%;
  border-radius: 0.75rem; background: #000;
}
#lightbox-inner.mp4 iframe { display: none; }
#lightbox-inner.mp4 #lightbox-video { display: block; }
#lightbox-inner iframe {
  width: 100%; height: 100%;
  border: none; border-radius: 0.75rem;
}
#lightbox-close {
  position: absolute;
  top: -2.5rem; right: 0;
  background: none; border: none;
  color: #fff; font-size: 2rem;
  cursor: pointer; line-height: 1;
  opacity: 0.8;
}
#lightbox-close:hover { opacity: 1; }
#lightbox-title {
  position: absolute;
  bottom: -2.25rem; left: 0;
  color: #fff; font-size: 0.85rem;
  opacity: 0.7; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
  max-width: 100%;
}
</style>

<!-- Lightbox -->
<div id="video-lightbox" onclick="closeLightbox(event)">
  <div id="lightbox-inner">
    <button id="lightbox-close" onclick="closeLightbox()">✕</button>
    <iframe id="lightbox-iframe" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    <video id="lightbox-video" controls playsinline preload="none"></video>
    <div id="lightbox-title"></div>
  </div>
</div>

<!-- Hero -->
<section class="bg-[#0D1235] text-white py-28 px-4">
  <div class="max-w-5xl mx-auto">
    <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">VIDEO LIBRARY</p>
    <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">See NetSuite in action.</h1>
    <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed">
      Short Inscio U explainers, plus official NetSuite product demos. Click any video to play.
    </p>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(videoSchema)}></script>

<script type="application/json" id="inscio-videos" set:html={JSON.stringify(inscioMap)}></script>

<!-- Video Categories -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Inscio U -->
    <div id="inscio-u">
      <h2 class="text-2xl font-bold text-gray-900 mb-3 pb-1">Inscio U</h2>
      <p class="text-gray-500 mb-8 pb-4 border-b border-gray-100">Short explainers on NetSuite topics, built for owners and CFOs.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {inscioVideos.map((v) => (
          <div id={v.slug} class="scroll-mt-28">
            <div class="video-thumb mb-3" onclick={`openInscioVideo('${v.slug}')`}>
              <img src={v.poster} alt={v.title} loading="lazy" />
              <div class="absolute top-3 left-3">
                <span class="bg-blue-600 text-white text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">Inscio U</span>
              </div>
              <div class="absolute bottom-3 right-3">
                <span class="bg-black/70 text-white text-xs font-semibold px-2 py-0.5 rounded">{v.length}</span>
              </div>
              <div class="play-btn">
                <svg viewBox="0 0 68 68" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="34" cy="34" r="34" fill="#2563EB"/>
                  <path d="M27 21 49 34 27 47z" fill="#fff"/>
                </svg>
              </div>
            </div>
            <p class="text-sm font-semibold text-gray-900 leading-snug">{v.title}</p>
            <p class="text-xs text-gray-500 mt-1 leading-snug">{v.description}</p>
            <div class="flex items-center gap-4 mt-2 text-xs font-semibold">
              <button type="button" class="text-blue-600 hover:text-blue-700" onclick={`copyVideoLink(this, '${v.slug}')`}>Copy link</button>
              <a class="text-blue-600 hover:text-blue-700" href={`mailto:?subject=${encodeURIComponent('Worth ' + v.length + ': ' + v.title)}&body=${encodeURIComponent('https://inscio.com/videos#' + v.slug)}`}>Email</a>
            </div>
          </div>
        ))}
      </div>
    </div>

    {categories.map((cat) => (
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-8 pb-4 border-b border-gray-100">{cat.title}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {cat.videos.map((v) => (
            <div>
              <div class="video-thumb mb-3" onclick={`openLightbox('${v.id}', '${v.title.replace(/'/g, "\\'")}')`}>
                <img src={`https://img.youtube.com/vi/${v.id}/hqdefault.jpg`} alt={v.title} loading="lazy" />
                <div class="play-btn">
                  <svg viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
                    <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#FF0000"/>
                    <path d="M45 24 27 14v20" fill="#fff"/>
                  </svg>
                </div>
              </div>
              <p class="text-sm font-semibold text-gray-900 leading-snug">{v.title}</p>
            </div>
          ))}
        </div>
      </div>
    ))}

    <!-- Interactive Walkthroughs -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-3 pb-1">Interactive Walkthroughs</h2>
      <p class="text-gray-500 mb-8 pb-4 border-b border-gray-100">Click-through demos showing NetSuite functionality in action — no demo signup or sales call required.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {walkthroughs.map((w) => (
          <a href={w.href} class="group block">
            <div class="relative aspect-video rounded-lg overflow-hidden mb-3 shadow-sm group-hover:shadow-lg transition-shadow">
              <img src={w.image} alt={w.title} loading="lazy" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-blue-600/0 group-hover:bg-blue-600/10 transition-colors"></div>
              <div class="absolute top-3 left-3">
                <span class="bg-blue-600 text-white text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">Interactive</span>
              </div>
            </div>
            <p class="text-sm font-semibold text-gray-900 leading-snug group-hover:text-blue-600 transition-colors">{w.title}</p>
            <p class="text-xs text-gray-500 mt-1 leading-snug">{w.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-gray-50 py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold text-gray-900 mb-4">Want a personalized walkthrough?</h2>
    <p class="text-gray-500 mb-8">Book a live demo tailored to your specific business and industry.</p>
    <a href="javascript:void(0)" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session?hide_gdpr_banner=1'});return false;"
      class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-4 rounded transition-colors">
      Book a Free Strategy Call
    </a>
  </div>
</section>

<script is:inline>
var INSCIO = JSON.parse(document.getElementById('inscio-videos').textContent);
function openLightbox(videoId, title) {
  document.getElementById('lightbox-inner').classList.remove('mp4');
  document.getElementById('lightbox-iframe').src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
  document.getElementById('lightbox-title').textContent = title;
  document.getElementById('video-lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox(e) {
  if (e && e.target !== document.getElementById('video-lightbox') && e.target !== document.getElementById('lightbox-close')) return;
  document.getElementById('lightbox-iframe').src = '';
  var vid = document.getElementById('lightbox-video');
  vid.pause(); vid.removeAttribute('src'); vid.load();
  document.getElementById('lightbox-inner').classList.remove('mp4');
  document.getElementById('video-lightbox').classList.remove('open');
  if (INSCIO[location.hash.slice(1)]) history.replaceState(null, '', location.pathname + location.search);
  document.body.style.overflow = '';
}
function openInscioVideo(slug) {
  var v = INSCIO[slug];
  if (!v) return;
  var vid = document.getElementById('lightbox-video');
  vid.poster = v.poster;
  vid.src = v.src;
  document.getElementById('lightbox-inner').classList.add('mp4');
  document.getElementById('lightbox-title').textContent = v.title;
  document.getElementById('video-lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
  if (location.hash !== '#' + slug) history.replaceState(null, '', '#' + slug);
  var p = vid.play(); if (p && p.catch) p.catch(function () {});
}
function copyVideoLink(btn, slug) {
  var url = 'https://inscio.com/videos#' + slug;
  var done = function () { btn.textContent = 'Link copied'; setTimeout(function () { btn.textContent = 'Copy link'; }, 2000); };
  if (navigator.clipboard) { navigator.clipboard.writeText(url).then(done, function () { window.prompt('Copy this link:', url); }); }
  else { window.prompt('Copy this link:', url); }
}
function openFromHash() {
  var slug = location.hash.slice(1);
  if (INSCIO[slug]) {
    var el = document.getElementById(slug);
    if (el) el.scrollIntoView({ block: 'center' });
    openInscioVideo(slug);
  }
}
window.addEventListener('hashchange', openFromHash);
openFromHash();
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeLightbox();
});
</script>

</Layout>
