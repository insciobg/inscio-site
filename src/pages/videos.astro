const inscioVideos = [
  {
    slug: 'revenue-recognition',
    topic: 'Revenue Recognition',
    seoTitle: 'What Is Revenue Recognition? Cash vs. Revenue | NetSuite Explained',
    transcript: [
      "A customer signs a one-year service contract, $24,000 paid up front. The check clears in January, so January looks like your best month ever. It isn't.",
      "You haven't earned that money. You've been paid to keep a promise, 12 months of service. One month in, you've earned $2,000. The other $22,000, you still owe it. In work.",
      "Book it all in January, and your numbers lie twice. January looks like a boom. The next 11 months look like a slump, while your crew is out doing the work.",
      "Now add a real deal, one invoice, a machine, the installation, and two years of service. Three promises, three different clocks. Tracking that in a spreadsheet works for five contracts, not for 500.",
      "NetSuite handles it with revenue rules. It breaks each sale into its promises, and can even split the price fairly between them. It holds back what you haven't earned, and releases it as you deliver. Month by month. So when your banker, your auditor, or a buyer opens your books, the revenue is real.",
      "Keep in mind, the rules don't write themselves. Someone has to decide when each promise counts as kept. Get that right once, and every contract follows it.",
      "Cash tells you what you collected. Revenue tells you what you earned. You should be able to see both. Talk to Inscio."
    ],
    title: 'Revenue Is What You Earned',
    description: "A $24,000 contract paid up front makes January look like a boom and the next 11 months look like a slump. Here's how NetSuite revenue rules recognize revenue as you deliver.",
    src: '/videos/inscio-u/revenue-recognition.mp4?v=4',
    poster: '/videos/inscio-u/revenue-recognition-poster.jpg?v=4',
    length: '1:19',
    duration: 'PT1M19S',
    uploadDate: '2026-11-24',
  },
  {
    slug: 'standard-cost-variances',
    topic: 'Standard Cost Variances',
    seoTitle: 'Standard Cost Variances Explained: Price vs. Quantity | NetSuite',
    transcript: [
      "You plan to build 1,000 units at $50 each. $50,000. The job closed at $62,000. $12,000, gone. And your P&L doesn't say why.",
      "No name, no reason, so you ask around. Purchasing blames the supplier. The shop blames the material. Everyone has a theory. Nobody has a number.",
      "Here's the idea that fixes it. A standard cost is a recipe. It says what one unit should cost, this much steel, at this price. When real life doesn't match the recipe, the difference is called a variance. And there are two ways to miss. You paid more than planned, or you used more than planned.",
      "NetSuite checks the recipe on every purchase and every build and puts each miss in its own bucket. Steel went up. $7,000. Price. Scrap on the line. $5,000. Quantity.",
      "Same $12,000. But now it has a name, and a name is something you can fix. Call the supplier. Walk the line.",
      "Keep in mind, the recipe is only as good as the day you wrote it. Standard costs have to be set up front and kept current. Let them go stale and every variance is noise.",
      "Stop guessing where the money went. Talk to Inscio."
    ],
    title: 'Know Where the Money Went',
    description: "The job was planned at $50,000 and closed at $62,000. Your P&L doesn't say why. Here's how NetSuite standard costing gives every overrun a name you can fix.",
    src: '/videos/inscio-u/standard-cost-variances.mp4',
    poster: '/videos/inscio-u/standard-cost-variances-poster.jpg',
    length: '1:13',
    duration: 'PT1M13S',
    uploadDate: '2026-11-24',
  },
  {
    slug: 'landed-cost',
    topic: 'Landed Cost',
    seoTitle: 'What Is Landed Cost? Why Your Margin Is Wrong | NetSuite Explained',
    transcript: [
      "You bought a part for $60. You sold it for $100. 40% margin. Nice work. Except it's not true.",
      "That part didn't teleport to your dock. It rode a ship. It cleared customs. It got insured, trucked, and unloaded. Freight. Duty. Insurance. 14 more dollars per part. Your real cost is $74. Your real margin is 26%.",
      "So where did that $14 go? In a lot of companies, it lands on an expense line called freight, far away from the product that caused it. The cost is real. It's just hiding.",
      "That means you're pricing, quoting, and discounting on a number that's wrong. And when tariffs jump, you're the last to know which product stopped making money.",
      "NetSuite fixes this with something called landed cost. Freight bills and duty charges get spread across the items they belong to. By weight, by quantity, or by value. Even when the freight bill shows up weeks after the shipment. Now, every item carries its true cost. And your margin report finally tells the truth.",
      "Landed cost isn't switched on out of the box. It has to be turned on and set up item by item. Do that right, and you'll know which products make you money. Skip it, and you're guessing.",
      "Your margin shouldn't be a guess. Talk to Inscio."
    ],
    title: "Your Margin Shouldn't Be a Guess",
    description: "Bought for $60, sold for $100. That's not a 40% margin once freight, duty, and insurance land. Here's how NetSuite landed cost puts the real cost on every item.",
    src: '/videos/inscio-u/landed-cost.mp4',
    poster: '/videos/inscio-u/landed-cost-poster.jpg',
    length: '1:21',
    duration: 'PT1M21S',
    uploadDate: '2026-11-24',
  },
  {
    slug: 'the-system-underneath-ai',
    topic: 'AI & NetSuite',
    seoTitle: 'Is Your Data Ready for AI? The System Underneath AI | NetSuite',
    transcript: [
      "Everyone wants to know what AI can do for their business. Almost no one asks what AI needs. AI runs on data. Clean. Connected. In one place.",
      "Lately, there's a lot of vendors pitching a lightweight ledger. An AI tool for every job. Agents to connect them. Pick the best tool for every task. Skip the big ERP.",
      "We've been here before. It used to be called best-of-breed. Every system had its own version of the truth. Month-end became a reconciliation project. The real source of truth was a spreadsheet. That's why companies moved to unified platforms like NetSuite.",
      "The new stack is the old problem. Better tools. Same trap. Integrations are not a source of truth. They're translations.",
      "In the old world, an accountant caught the mistakes. The new stack replaces that person with an agent. Agents are fast. They act on whatever data they can see. Fragmented data used to cost you time. With AI, it costs you decisions.",
      "NetSuite runs everything on one database. One sales order. One customer. One truth. Nothing to reconcile, because there's no between. That's the foundation AI needs.",
      "If AI is on your plan, the first line item probably isn't AI. It's the system underneath it. That's what Inscio helps you get right."
    ],
    title: 'The System Underneath AI',
    description: "Everyone wants to know what AI can do for their business. Almost no one asks what AI needs. Here's why the first line item on your AI plan probably isn't AI.",
    src: '/videos/inscio-u/netsuite-ai-explainer.mp4',
    poster: '/videos/inscio-u/netsuite-ai-explainer-poster.jpg',
    length: '1:18',
    duration: 'PT1M18S',
    uploadDate: '2026-11-23',
  },
];

const inscioMap = Object.fromEntries(inscioVideos.map((v) => [v.slug, { title: v.title, src: v.src, poster: v.poster }]));

const videoSchema = inscioVideos.map((v) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: v.seoTitle,
  alternateName: v.title,
  description: v.description,
  thumbnailUrl: `https://inscio.com${v.poster}`,
  contentUrl: `https://inscio.com${v.src}`,
  embedUrl: `https://inscio.com/videos#${v.slug}`,
  uploadDate: v.uploadDate,
  duration: v.duration,
  transcript: v.transcript.join(' '),
  publisher: { '@type': 'Organization', name: 'Inscio', url: 'https://inscio.com' },
}));

const walkthroughs = [
  {
    title: 'NetSuite SuiteApprovals Workflow',
    description: 'A real multi-level purchase approval from the employee who submits it, to the purchasing manager who reviews it, to the CFO who signs off.',
    image: '/images/og/netsuite-suiteapprovals-demo.png',
    href: '/netsuite-suiteapprovals-demo',
  },
];
---

<Layout
  title="NetSuite Videos: Inscio U Explainers and Product Demos | Inscio"
  description="Short Inscio U explainers on NetSuite and AI, plus NetSuite product demos covering financials, analytics, supply chain, CRM, integrations, and industry solutions."
  ogImage="https://inscio.com/images/og/inscio-u-system-underneath-ai.jpg"
>

<style is:inline>
.video-thumb {
  position: relative;
  cursor: pointer;
  border-radius: 0.75rem;
  overflow: hidden;
  aspect-ratio: 16/9;
  background: #000;
}
.video-thumb img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: opacity 0.2s;
}
.video-thumb:hover img { opacity: 0.8; }
.play-btn {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.play-btn svg { width: 52px; height: 52px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5)); transition: transform 0.2s; }
.video-thumb:hover .play-btn svg { transform: scale(1.12); }

/* Lightbox */
#video-lightbox {
  display: none;
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(0,0,0,0.85);
  align-items: center; justify-content: center;
  padding: 1rem;
}
#video-lightbox.open { display: flex; }
#lightbox-inner {
  position: relative;
  width: 100%; max-width: 960px;
  aspect-ratio: 16/9;
}
#lightbox-video {
  display: none;
  width: 100%; height: 100%;
  border-radius: 0.75rem; background: #000;
}
#lightbox-inner.mp4 iframe { display: none; }
#lightbox-inner.mp4 #lightbox-video { display: block; }
#lightbox-inner iframe {
  width: 100%; height: 100%;
  border: none; border-radius: 0.75rem;
}
#lightbox-close {
  position: absolute;
  top: -2.5rem; right: 0;
  background: none; border: none;
  color: #fff; font-size: 2rem;
  cursor: pointer; line-height: 1;
  opacity: 0.8;
}
#lightbox-close:hover { opacity: 1; }
#lightbox-title {
  position: absolute;
  bottom: -2.25rem; left: 0;
  color: #fff; font-size: 0.85rem;
  opacity: 0.7; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
  max-width: 100%;
}
</style>

<!-- Lightbox -->
<div id="video-lightbox" onclick="closeLightbox(event)">
  <div id="lightbox-inner">
    <button id="lightbox-close" onclick="closeLightbox()">✕</button>
    <iframe id="lightbox-iframe" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    <video id="lightbox-video" controls playsinline preload="none"></video>
    <div id="lightbox-title"></div>
  </div>
</div>

<!-- Hero -->
<section class="bg-[#0D1235] text-white py-28 px-4">
  <div class="max-w-5xl mx-auto">
    <p class="text-blue-400 text-sm font-semibold uppercase tracking-widest mb-6">VIDEO LIBRARY</p>
    <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-8 max-w-3xl">See NetSuite in action.</h1>
    <p class="text-gray-300 text-lg md:text-xl max-w-2xl leading-relaxed">
      Short Inscio U explainers, plus official NetSuite product demos. Click any video to play.
    </p>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(videoSchema)}></script>

<script type="application/json" id="inscio-videos" set:html={JSON.stringify(inscioMap)}></script>

<!-- Video Categories -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Inscio U -->
    <div id="inscio-u">
      <h2 class="text-2xl font-bold text-gray-900 mb-3 pb-1">Inscio U</h2>
      <p class="text-gray-500 mb-8 pb-4 border-b border-gray-100">Short explainers on NetSuite topics, built for owners and CFOs.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {inscioVideos.map((v) => (
          <div id={v.slug} class="scroll-mt-28">
            <div class="video-thumb mb-3" onclick={`openInscioVideo('${v.slug}')`}>
              <img src={v.poster} alt={v.title} loading="lazy" />
              <div class="absolute top-3 left-3">
                <span class="bg-blue-600 text-white text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">Inscio U</span>
              </div>
              <div class="absolute bottom-3 right-3">
                <span class="bg-black/70 text-white text-xs font-semibold px-2 py-0.5 rounded">{v.length}</span>
              </div>
              <div class="play-btn">
                <svg viewBox="0 0 68 68" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="34" cy="34" r="34" fill="#2563EB"/>
                  <path d="M27 21 49 34 27 47z" fill="#fff"/>
                </svg>
              </div>
            </div>
            <p class="text-[11px] font-semibold uppercase tracking-wider text-blue-600 mb-1">{v.topic}</p>
            <p class="text-sm font-semibold text-gray-900 leading-snug">{v.title}</p>
            <p class="text-xs text-gray-500 mt-1 leading-snug">{v.description}</p>
            <div class="flex items-center gap-4 mt-2 text-xs font-semibold">
              <button type="button" class="text-blue-600 hover:text-blue-700" onclick={`copyVideoLink(this, '${v.slug}')`}>Copy link</button>
              <button type="button" class="text-blue-600 hover:text-blue-700" onclick={`emailVideoLink('${v.slug}')`}>Email</button>
            </div>
            <details class="mt-2 group">
              <summary class="text-xs font-semibold text-blue-600 hover:text-blue-700 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <span class="group-open:hidden">Read transcript</span><span class="hidden group-open:inline">Hide transcript</span>
              </summary>
              <div class="mt-2 space-y-2 text-xs text-gray-600 leading-relaxed">
                {v.transcript.map((p) => <p>{p}</p>)}
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>

    {categories.map((cat) => (
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-8 pb-4 border-b border-gray-100">{cat.title}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {cat.videos.map((v) => (
            <div>
              <div class="video-thumb mb-3" onclick={`openLightbox('${v.id}', '${v.title.replace(/'/g, "\\'")}')`}>
                <img src={`https://img.youtube.com/vi/${v.id}/hqdefault.jpg`} alt={v.title} loading="lazy" />
                <div class="play-btn">
                  <svg viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
                    <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#FF0000"/>
                    <path d="M45 24 27 14v20" fill="#fff"/>
                  </svg>
                </div>
              </div>
              <p class="text-sm font-semibold text-gray-900 leading-snug">{v.title}</p>
            </div>
          ))}
        </div>
      </div>
    ))}

    <!-- Interactive Walkthroughs -->
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-3 pb-1">Interactive Walkthroughs</h2>
      <p class="text-gray-500 mb-8 pb-4 border-b border-gray-100">Click-through demos showing NetSuite functionality in action — no demo signup or sales call required.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {walkthroughs.map((w) => (
          <a href={w.href} class="group block">
            <div class="relative aspect-video rounded-lg overflow-hidden mb-3 shadow-sm group-hover:shadow-lg transition-shadow">
              <img src={w.image} alt={w.title} loading="lazy" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-blue-600/0 group-hover:bg-blue-600/10 transition-colors"></div>
              <div class="absolute top-3 left-3">
                <span class="bg-blue-600 text-white text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">Interactive</span>
              </div>
            </div>
            <p class="text-sm font-semibold text-gray-900 leading-snug group-hover:text-blue-600 transition-colors">{w.title}</p>
            <p class="text-xs text-gray-500 mt-1 leading-snug">{w.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-gray-50 py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold text-gray-900 mb-4">Want a personalized walkthrough?</h2>
    <p class="text-gray-500 mb-8">Book a live demo tailored to your specific business and industry.</p>
    <a href="javascript:void(0)" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/brian-gallagher-inscio/netsuite-strategy-session?hide_gdpr_banner=1'});return false;"
      class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-4 rounded transition-colors">
      Book a Free Strategy Call
    </a>
  </div>
</section>

<script is:inline>
var INSCIO = JSON.parse(document.getElementById('inscio-videos').textContent);
function openLightbox(videoId, title) {
  document.getElementById('lightbox-inner').classList.remove('mp4');
  document.getElementById('lightbox-iframe').src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
  document.getElementById('lightbox-title').textContent = title;
  document.getElementById('video-lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox(e) {
  if (e && e.target !== document.getElementById('video-lightbox') && e.target !== document.getElementById('lightbox-close')) return;
  document.getElementById('lightbox-iframe').src = '';
  var vid = document.getElementById('lightbox-video');
  vid.pause(); vid.removeAttribute('src'); vid.load();
  document.getElementById('lightbox-inner').classList.remove('mp4');
  document.getElementById('video-lightbox').classList.remove('open');
  if (INSCIO[location.hash.slice(1)]) history.replaceState(null, '', location.pathname + location.search);
  document.body.style.overflow = '';
}
var currentInscio = null;
function trackInscio(name, params) {
  if (typeof window.gtag === 'function') window.gtag('event', name, params);
}
(function () {
  var vid = document.getElementById('lightbox-video');
  var marks = {};
  vid.addEventListener('play', function () {
    if (!currentInscio || currentInscio.started) return;
    currentInscio.started = true; marks = {};
    trackInscio('video_start', { video_title: currentInscio.title, video_slug: currentInscio.slug, video_provider: 'inscio_u', video_url: location.origin + '/videos#' + currentInscio.slug });
  });
  vid.addEventListener('timeupdate', function () {
    if (!currentInscio || !vid.duration) return;
    var pct = vid.currentTime / vid.duration * 100;
    [25, 50, 75].forEach(function (m) {
      if (pct >= m && !marks[m]) { marks[m] = true; trackInscio('video_progress', { video_title: currentInscio.title, video_slug: currentInscio.slug, video_provider: 'inscio_u', video_percent: m }); }
    });
  });
  vid.addEventListener('ended', function () {
    if (!currentInscio) return;
    trackInscio('video_complete', { video_title: currentInscio.title, video_slug: currentInscio.slug, video_provider: 'inscio_u', video_percent: 100 });
  });
})();
function openInscioVideo(slug) {
  var v = INSCIO[slug];
  if (!v) return;
  var vid = document.getElementById('lightbox-video');
  vid.poster = v.poster;
  vid.src = v.src;
  document.getElementById('lightbox-inner').classList.add('mp4');
  document.getElementById('lightbox-title').textContent = v.title;
  document.getElementById('video-lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
  if (location.hash !== '#' + slug) history.replaceState(null, '', '#' + slug);
  currentInscio = { slug: slug, title: v.title, started: false };
  var p = vid.play(); if (p && p.catch) p.catch(function () {});
}
function emailVideoLink(slug) {
  var v = INSCIO[slug]; if (!v) return;
  trackInscio('share', { method: 'email', content_type: 'video', item_id: slug });
  var url = 'https://inscio.com/videos#' + slug;
  window.location.href = 'mai' + 'lto:?subject=' + encodeURIComponent('Worth a quick watch: ' + v.title) + '&body=' + encodeURIComponent(url);
}
function copyVideoLink(btn, slug) {
  trackInscio('share', { method: 'copy_link', content_type: 'video', item_id: slug });
  var url = 'https://inscio.com/videos#' + slug;
  var done = function () { btn.textContent = 'Link copied'; setTimeout(function () { btn.textContent = 'Copy link'; }, 2000); };
  if (navigator.clipboard) { navigator.clipboard.writeText(url).then(done, function () { window.prompt('Copy this link:', url); }); }
  else { window.prompt('Copy this link:', url); }
}
function openFromHash() {
  var slug = location.hash.slice(1);
  if (INSCIO[slug]) {
    var el = document.getElementById(slug);
    if (el) el.scrollIntoView({ block: 'center' });
    openInscioVideo(slug);
  }
}
window.addEventListener('hashchange', openFromHash);
openFromHash();
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeLightbox();
});
</script>

</Layout>
